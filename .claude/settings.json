{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "KILN_PROJECT": "ion-render",
    "KILN_BACKEND_DIR": "",
    "KILN_FRONTEND_DIR": "",
    "KILN_TEST_ENV": ""
  },
  "autoCompactWindow": 400000,
  "plansDirectory": ".claude/plans",
  "extraKnownMarketplaces": {
    "ion-repo": {
      "source": {
        "source": "github",
        "repo": "antoine-tena/ion-repo",
        "ref": "main"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "ion-repo@ion-repo": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)"
    ]
  }
}
